{
  "name": "hexlet-web-design-course",
  "private": true,
  "scripts": {
    "dev:p026": "slidev lessons/P026/slides.md --open",
    "build:p026": "slidev build lessons/P026/slides.md --out ../../dist/P026",
    "export:p026": "slidev export lessons/P026/slides.md --output ../../dist/P026.pdf",
    "validate": "node scripts/validate.mjs",
    "dev:master": "slidev templates/master/slides.md --open",
    "build:master": "slidev build templates/master/slides.md --out ../../dist/master",
    "dev:p001": "slidev lessons/P001/slides.md --open",
    "build:p001": "slidev build lessons/P001/slides.md --base /hexlet-web-design-course/course/pm1/P001/ --out ../../dist/course/pm1/P001",
    "dev:p031": "slidev lessons/P031/slides.md --open",
    "build:p031": "slidev build lessons/P031/slides.md --base /hexlet-web-design-course/course/pm1/P031/ --out ../../dist/course/pm1/P031",
    "prepare:site": "node scripts/prepare-site.mjs",
    "validate:brand-build": "node scripts/validate-built-brand.mjs",
    "build:all": "npm run validate && npm run build:master && npm run build:p001 && npm run build:p031 && npm run build:p026 && npm run prepare:site && npm run validate:brand-build"
  },
  "devDependencies": {
    "@slidev/cli": "latest",
    "@slidev/theme-default": "latest"
  }
}
